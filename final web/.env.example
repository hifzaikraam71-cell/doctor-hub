# Copy this file to .env.local for local dev:
#   copy .env.example .env.local
#
# For Vercel deploy: add the SAME variables in Project → Settings → Environment Variables
# (.env.example is NOT used automatically by Next.js or Vercel)

# Supabase → Settings → API
# URL must be project root only, e.g. https://abcdefgh.supabase.co (NO /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT — any random string, 32+ characters
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Local: http://localhost:3000 | Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
